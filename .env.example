SECRET_KEY=django-insecure-change-me-in-production-please-override-in-env
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mess_market_db

MEDIA_ROOT=media
MEDIA_URL=/media/

MAX_UPLOAD_SIZE=5242880
ALLOWED_BILL_EXTENSIONS=jpg,jpeg,png,webp,pdf
# Obscure raw Django admin path (default django-admin/). Example: DJANGO_ADMIN_PATH=mgmt-x7q2/
DJANGO_ADMIN_PATH=django-admin/

